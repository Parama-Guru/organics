// Organics storefront data model.
// Money is stored as integer minor units (cents/paise) to avoid float rounding errors.

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm]
}

model Category {
  id            String    @id @default(cuid())
  name          String    @unique
  slug          String    @unique
  description   String?
  // Tamil copy. Null falls back to the English column, so a new category is
  // never blank in the Tamil UI.
  nameTa        String?
  descriptionTa String?
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([slug])
}

// A farmer only becomes visible to shoppers at VERIFIED; everything else hides
// their listings. Mirrors Amazon's "seller account is approved before listings
// go live" rule.
enum FarmerStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

model Farmer {
  id             String       @id @default(cuid())
  slug           String       @unique
  contactName    String
  farmName       String
  phone          String
  email          String       @unique
  region         String
  about          String?
  aboutTa        String?
  photoUrl       String?
  status         FarmerStatus @default(PENDING)
  // Evidence captured at signup and checked by an admin before VERIFIED.
  // "Certified organic" is a regulated claim in India, so the scheme, the
  // certificate number and its expiry are recorded and shown, not just asserted.
  govtIdLast4    String?
  certifier      String?
  certificateNo  String?
  certificateUrl String?
  certifiedUntil DateTime?
  verifiedAt     DateTime?
  reviewNote     String?
  products       Product[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
  @@index([region])
  @@index([farmName(ops: raw("gin_trgm_ops"))], map: "Farmer_farmName_trgm_idx", type: Gin)
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model Product {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  description   String
  nameTa        String?
  descriptionTa String?
  priceCents    Int
  unit          String
  imageUrl      String?
  emoji         String?
  region        String?
  stock         Int            @default(0)
  isActive      Boolean        @default(true)
  isFeatured    Boolean        @default(false)
  // Required: nothing is listed without a named farm behind it, and the listing
  // inherits that farm's verification state.
  farmerId      String
  farmer        Farmer         @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([isActive, isFeatured])
  @@index([region])
  @@index([farmerId])
  // Trigram indexes: search uses ILIKE '%term%', which no b-tree can serve. Without
  // these a term that matches little or nothing scans the whole table.
  @@index([name(ops: raw("gin_trgm_ops"))], map: "Product_name_trgm_idx", type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], map: "Product_description_trgm_idx", type: Gin)
  @@index([region(ops: raw("gin_trgm_ops"))], map: "Product_region_trgm_idx", type: Gin)
}
