// Organics storefront data model.
// Money is stored as integer minor units (cents/paise) to avoid float rounding errors.

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm]
}

model Category {
  id            String    @id @default(cuid())
  name          String    @unique
  slug          String    @unique
  description   String?
  // Tamil copy. Null falls back to the English column, so a new category is
  // never blank in the Tamil UI.
  nameTa        String?
  descriptionTa String?
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([slug])
  @@index([nameTa(ops: raw("gin_trgm_ops"))], map: "Category_nameTa_trgm_idx", type: Gin)
}

// A district. Was a free-text column repeated on Farmer and Product, with the
// Tamil spelling hard-coded in a TypeScript map — so a typo produced a silent
// second "region" in the filters and Tamil silently fell back to English.
model Region {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String    @unique
  nameTa    String?
  // District centre, used to order farms and shops by rough distance. A
  // visitor's own coordinates are never sent here or stored anywhere.
  latitude  Float?
  longitude Float?
  farmers   Farmer[]
  products  Product[]
  customers Customer[]
  stores    OrganicStore[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([slug])
  @@index([nameTa(ops: raw("gin_trgm_ops"))], map: "Region_nameTa_trgm_idx", type: Gin)
}

// A farmer only becomes visible to shoppers at VERIFIED; everything else hides
// their listings. Mirrors Amazon's "seller account is approved before listings
// go live" rule.
enum FarmerStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

model Farmer {
  id             String       @id @default(cuid())
  slug           String       @unique
  contactName    String
  farmName       String
  phone          String
  email          String       @unique
  regionId       String
  region         Region       @relation(fields: [regionId], references: [id], onDelete: Restrict)
  about          String?
  aboutTa        String?
  photoUrl       String?
  status         FarmerStatus @default(PENDING)
  // Evidence captured at signup and checked by an admin before VERIFIED.
  // "Certified organic" is a regulated claim in India, so the scheme, the
  // certificate number and its expiry are recorded and shown, not just asserted.
  govtIdLast4    String?
  certifier      String?
  certificateNo  String?
  certificateUrl String?
  certifiedUntil DateTime?
  verifiedAt     DateTime?
  reviewNote     String?
  // A flag is an internal triage marker, separate from publication status. It
  // lets staff investigate a live or closed record without changing what the
  // public can see until a decision is made.
  flaggedAt      DateTime?
  flagReason     String?
  // Portal access is granted separately from verification: an admin can approve
  // a farm's listings without handing over a login, and can revoke the login
  // without unpublishing the farm.
  passwordHash   String?
  portalSessionVersion Int        @default(0)
  portalEnabledAt DateTime?
  lastSignInAt   DateTime?
  products       Product[]
  savedBy        SavedFarmer[]
  enquiries      PrivateEnquiry[]
  sponsoredPlacements SponsoredPlacement[]
  reviewEvents   SellerReviewEvent[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
  @@index([regionId])
  @@index([farmName(ops: raw("gin_trgm_ops"))], map: "Farmer_farmName_trgm_idx", type: Gin)
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model Product {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  description   String
  nameTa        String?
  descriptionTa String?
  priceCents    Int
  unit          String
  imageUrl      String?
  emoji         String?
  regionId      String?
  region        Region?        @relation(fields: [regionId], references: [id], onDelete: SetNull)
  stock         Int            @default(0)
  isActive      Boolean        @default(true)
  isFeatured    Boolean        @default(false)
  // Required: nothing is listed without a named farm behind it, and the listing
  // inherits that farm's verification state.
  farmerId      String
  farmer        Farmer         @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  savedBy       SavedProduct[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([isActive, isFeatured])
  @@index([regionId])
  @@index([farmerId])
  // Trigram indexes: search uses ILIKE '%term%', which no b-tree can serve. Without
  // these a term that matches little or nothing scans the whole table.
  @@index([name(ops: raw("gin_trgm_ops"))], map: "Product_name_trgm_idx", type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], map: "Product_description_trgm_idx", type: Gin)
  // The Tamil columns carry the same indexes: on a Tamil-only site these are the
  // ones a visitor's keywords actually hit.
  @@index([nameTa(ops: raw("gin_trgm_ops"))], map: "Product_nameTa_trgm_idx", type: Gin)
  @@index([descriptionTa(ops: raw("gin_trgm_ops"))], map: "Product_descriptionTa_trgm_idx", type: Gin)
}

// A shop that resells certified organic produce. Reviewed on the same footing
// as a farm — apply, get checked, get listed — but it stocks rather than grows,
// so it carries an address and an FSSAI licence instead of acreage, and it has
// no listings of its own.
enum StoreStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

model OrganicStore {
  id             String      @id @default(cuid())
  slug           String      @unique
  storeName      String
  contactName    String
  phone          String
  email          String      @unique
  regionId       String
  region         Region      @relation(fields: [regionId], references: [id], onDelete: Restrict)
  // Street address; the district lives on the region relation, as everywhere else.
  addressLine    String
  about          String?
  aboutTa        String?
  photoUrl       String?
  status         StoreStatus @default(PENDING)
  // Evidence gathered before listing. A retail outlet needs an FSSAI licence to
  // sell food at all, which is the shop-side equivalent of a farm's NPOP scheme.
  govtIdLast4    String?
  fssaiNumber    String?
  certifier      String?
  certificateNo  String?
  certificateUrl String?
  certifiedUntil DateTime?
  verifiedAt     DateTime?
  reviewNote     String?
  flaggedAt      DateTime?
  flagReason     String?
  // Store owners receive a one-time invite and choose their own password. The
  // version is carried by every session so revocation takes effect at once.
  passwordHash   String?
  portalSessionVersion Int     @default(0)
  portalEnabledAt DateTime?
  lastSignInAt   DateTime?
  enquiries      PrivateEnquiry[]
  sponsoredPlacements SponsoredPlacement[]
  reviewEvents   SellerReviewEvent[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status])
  @@index([regionId])
  @@index([storeName(ops: raw("gin_trgm_ops"))], map: "OrganicStore_storeName_trgm_idx", type: Gin)
}

// Who is writing in. The contact form asks first, because a farmer wanting to
// list and a buyer chasing an order need different answers.
enum ContactRole {
  CUSTOMER
  FARMER
  STORE
  OTHER
}

// Contact messages are stored rather than emailed. Mail is optional
// configuration, and a form that silently drops what people write is worse than
// no form; the admin area reads these.
model ContactMessage {
  id        String      @id @default(cuid())
  role      ContactRole
  name      String
  email     String
  phone     String?
  message   String
  // Cleared by an admin once it has been answered.
  handledAt DateTime?
  createdAt DateTime    @default(now())

  @@index([handledAt, createdAt])
  @@index([role])
}

// A buyer account unlocks checked seller details, private enquiries, and a
// shortlist. Payment authorization is provider-hosted, so no address or card
// details are stored here.
model Customer {
  id            String         @id @default(cuid())
  // Stored lower-cased; the unique index is what stops duplicate signups.
  email         String         @unique
  // Public handle, lower-cased and unique. Deliberately NOT a sign-in
  // credential: it is checked for availability live while someone types, and an
  // identifier that answers "does this exist" must never also open a login.
  // Null for accounts created before handles existed.
  username      String?        @unique
  // Null for Google-only accounts. Otherwise scrypt:<salt-hex>:<key-hex>.
  passwordHash  String?
  // Google supplies a verified email; local accounts set this through a
  // single-use email-verification link.
  emailVerifiedAt DateTime?
  // Local sign-up already collects the normal details. Google sign-in only
  // returns an email, so a new Google account completes them on the next page.
  profileCompletedAt DateTime?
  name          String
  phone         String?
  // Their own district, used to sort nearby farms first. Same table the farms
  // and listings use, so "Erode" is one row rather than three spellings.
  regionId      String?
  region        Region?        @relation(fields: [regionId], references: [id], onDelete: SetNull)
  // Which language to serve after sign-in, so the choice survives a new device.
  locale        String         @default("ta")
  status        CustomerStatus @default(ACTIVE)
  identities    CustomerIdentity[]
  subscription  CustomerSubscription?
  enquiries      PrivateEnquiry[]
  savedProducts SavedProduct[]
  savedFarmers  SavedFarmer[]
  // Set when the password last changed, so a support question about "why was I
  // signed out" has an answer.
  passwordSetAt DateTime?
  // Incremented whenever credentials change. Every session carries the value
  // it authenticated against, so old and in-flight logins are rejected.
  sessionVersion Int             @default(0)
  lastSeenAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([email])
  @@index([regionId])
  @@index([status])
}

// Suspending rather than deleting keeps the shortlist intact if an account is
// locked for abuse and later cleared.
enum CustomerStatus {
  ACTIVE
  SUSPENDED
}

enum EnquiryDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum PromotionStatus {
  ACTIVE
  PAUSED
  ENDED
}

model SponsoredPlacement {
  id           String          @id @default(cuid())
  farmerId     String?
  farmer       Farmer?         @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  storeId      String?
  store        OrganicStore?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  startsAt     DateTime
  endsAt       DateTime
  priority     Int             @default(0)
  status       PromotionStatus @default(ACTIVE)
  internalNote String?
  metrics      SponsoredMetric[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status, startsAt, endsAt])
  @@index([farmerId])
  @@index([storeId])
}

// Daily totals only: no visitor id, account id, IP address or user-agent is
// retained. Rate limiting happens in the short-lived session store before an
// aggregate is incremented.
model SponsoredMetric {
  placementId String
  placement   SponsoredPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  date        DateTime
  impressions Int                @default(0)
  clicks      Int                @default(0)

  @@id([placementId, date])
  @@index([date])
}

enum SellerReviewAction {
  STATUS_CHANGED
  FLAGGED
  FLAG_CLEARED
  EVIDENCE_UPDATED
}

// The admin area intentionally remains one-passphrase-only. This still gives a
// durable timeline of what changed and when, without pretending we can name an
// individual staff member when the authentication model cannot.
model SellerReviewEvent {
  id         String             @id @default(cuid())
  farmerId   String?
  farmer     Farmer?            @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  storeId    String?
  store      OrganicStore?      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  action     SellerReviewAction
  fromStatus String?
  toStatus   String?
  note       String?
  createdAt  DateTime           @default(now())

  @@index([farmerId, createdAt])
  @@index([storeId, createdAt])
}

// Stored before SMTP is attempted. The recipient address is resolved from a
// VERIFIED database row and never accepted from browser JSON.
model PrivateEnquiry {
  id                String                @id @default(cuid())
  customerId        String
  customer          Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  farmerId          String?
  farmer            Farmer?               @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  storeId           String?
  store              OrganicStore?         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  senderEmail        String
  recipientName     String
  recipientEmail    String
  subject            String
  message            String
  shareEmail         Boolean               @default(false)
  deliveryStatus     EnquiryDeliveryStatus @default(PENDING)
  deliveryAttempts   Int                   @default(0)
  lastDeliveryError  String?
  sentAt             DateTime?
  handledAt          DateTime?
  // Independent of the staff resolution marker: a seller reading the message
  // in their own portal must not silently close it in the staff queue.
  sellerReadAt       DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([customerId, createdAt])
  @@index([farmerId, createdAt])
  @@index([storeId, createdAt])
  @@index([deliveryStatus, createdAt])
  @@index([handledAt, createdAt])
}

enum AuthProvider {
  GOOGLE
}

// Provider account ids, not emails, are the durable identity. A Google email
// can change while its `sub` claim does not.
model CustomerIdentity {
  id                String       @id @default(cuid())
  customerId        String
  customer          Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider          AuthProvider
  providerAccountId String
  emailAtLink       String
  linkedAt          DateTime     @default(now())
  lastUsedAt        DateTime?

  @@unique([provider, providerAccountId])
  @@unique([customerId, provider])
  @@index([customerId])
}

enum SubscriptionPlan {
  TRIAL
  STARTER_MONTHLY
  STARTER_ANNUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

// One current subscription per customer. Billing is disabled initially; this
// records the trial and provider state for the deliberately dormant paid path.
model CustomerSubscription {
  id                     String             @id @default(cuid())
  customerId             String             @unique
  customer               Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan                   SubscriptionPlan   @default(TRIAL)
  status                 SubscriptionStatus @default(TRIALING)
  trialStartedAt         DateTime
  trialEndsAt            DateTime
  currentPeriodStartedAt DateTime?
  currentPeriodEndsAt    DateTime?
  // Entitlement advances only after a validated captured charge, never merely
  // because a mandate or future subscription became active.
  paidThroughAt          DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  cancellationRequestedAt DateTime?
  cancelledAt            DateTime?
  provider               String?
  providerPlanId         String?
  agreedAmountPaise      Int?
  agreedCurrency         String?
  providerCustomerId     String?            @unique
  providerSubscriptionId String?            @unique
  providerStatus         String?
  providerLastEventAt    DateTime?
  // Claimed before contacting Razorpay. It prevents concurrent creation and
  // lets a webhook reconcile a response lost after remote creation.
  provisioningToken      String?            @unique
  provisioningStartedAt  DateTime?
  provisioningError      String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  paymentEvents          PaymentEvent[]
  attempts               SubscriptionAttempt[]

  @@index([status, currentPeriodEndsAt])
}

// One durable row per remote provisioning attempt. It survives deletion of the
// customer subscription so delayed provider events can be acknowledged or a
// remote mandate can still be found and cancelled without retaining buyer PII.
model SubscriptionAttempt {
  id                     String                @id
  subscriptionId         String?
  subscription           CustomerSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  provider               String
  plan                   SubscriptionPlan
  providerPlanId         String
  agreedAmountPaise      Int
  agreedCurrency         String
  providerSubscriptionId String?               @unique
  providerStatus         String?
  state                  String
  failureCode            String?
  startedAt              DateTime              @default(now())
  resolvedAt             DateTime?
  updatedAt              DateTime              @updatedAt

  @@index([subscriptionId, startedAt])
  @@index([state, startedAt])
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

// Raw provider payloads are intentionally not stored: the event type, durable
// provider id and processing result are enough for replay protection and audit.
model PaymentEvent {
  id              String             @id @default(cuid())
  provider        String
  providerEventId String
  eventType       String
  providerSubscriptionId String?
  providerCreatedAt DateTime?
  providerPaymentId String?
  providerInvoiceId String?
  amountPaise      Int?
  currency         String?
  subscriptionId  String?
  subscription    CustomerSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  status          PaymentEventStatus @default(RECEIVED)
  failureCode     String?
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?

  @@unique([provider, providerEventId])
  @@index([providerSubscriptionId, providerCreatedAt])
  @@index([subscriptionId, receivedAt])
  @@index([status, receivedAt])
}

model SavedProduct {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([customerId, productId])
  @@index([customerId, createdAt])
}

model SavedFarmer {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  farmerId   String
  farmer     Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([customerId, farmerId])
  @@index([customerId, createdAt])
}
