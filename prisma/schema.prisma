// Organics storefront data model.
// Money is stored as integer minor units (cents/paise) to avoid float rounding errors.

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm]
}

model Category {
  id            String    @id @default(cuid())
  name          String    @unique
  slug          String    @unique
  description   String?
  // Tamil copy. Null falls back to the English column, so a new category is
  // never blank in the Tamil UI.
  nameTa        String?
  descriptionTa String?
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([slug])
  @@index([nameTa(ops: raw("gin_trgm_ops"))], map: "Category_nameTa_trgm_idx", type: Gin)
}

// A district. Was a free-text column repeated on Farmer and Product, with the
// Tamil spelling hard-coded in a TypeScript map — so a typo produced a silent
// second "region" in the filters and Tamil silently fell back to English.
model Region {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String    @unique
  nameTa    String?
  farmers   Farmer[]
  products  Product[]
  customers Customer[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([slug])
  @@index([nameTa(ops: raw("gin_trgm_ops"))], map: "Region_nameTa_trgm_idx", type: Gin)
}

// A farmer only becomes visible to shoppers at VERIFIED; everything else hides
// their listings. Mirrors Amazon's "seller account is approved before listings
// go live" rule.
enum FarmerStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

model Farmer {
  id             String       @id @default(cuid())
  slug           String       @unique
  contactName    String
  farmName       String
  phone          String
  email          String       @unique
  regionId       String
  region         Region       @relation(fields: [regionId], references: [id], onDelete: Restrict)
  about          String?
  aboutTa        String?
  photoUrl       String?
  status         FarmerStatus @default(PENDING)
  // Evidence captured at signup and checked by an admin before VERIFIED.
  // "Certified organic" is a regulated claim in India, so the scheme, the
  // certificate number and its expiry are recorded and shown, not just asserted.
  govtIdLast4    String?
  certifier      String?
  certificateNo  String?
  certificateUrl String?
  certifiedUntil DateTime?
  verifiedAt     DateTime?
  reviewNote     String?
  // Portal access is granted separately from verification: an admin can approve
  // a farm's listings without handing over a login, and can revoke the login
  // without unpublishing the farm.
  passwordHash   String?
  portalEnabledAt DateTime?
  lastSignInAt   DateTime?
  products       Product[]
  savedBy        SavedFarmer[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
  @@index([regionId])
  @@index([farmName(ops: raw("gin_trgm_ops"))], map: "Farmer_farmName_trgm_idx", type: Gin)
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model Product {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  description   String
  nameTa        String?
  descriptionTa String?
  priceCents    Int
  unit          String
  imageUrl      String?
  emoji         String?
  regionId      String?
  region        Region?        @relation(fields: [regionId], references: [id], onDelete: SetNull)
  stock         Int            @default(0)
  isActive      Boolean        @default(true)
  isFeatured    Boolean        @default(false)
  // Required: nothing is listed without a named farm behind it, and the listing
  // inherits that farm's verification state.
  farmerId      String
  farmer        Farmer         @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  savedBy       SavedProduct[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([isActive, isFeatured])
  @@index([regionId])
  @@index([farmerId])
  // Trigram indexes: search uses ILIKE '%term%', which no b-tree can serve. Without
  // these a term that matches little or nothing scans the whole table.
  @@index([name(ops: raw("gin_trgm_ops"))], map: "Product_name_trgm_idx", type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], map: "Product_description_trgm_idx", type: Gin)
  // The Tamil columns carry the same indexes: on a Tamil-only site these are the
  // ones a visitor's keywords actually hit.
  @@index([nameTa(ops: raw("gin_trgm_ops"))], map: "Product_nameTa_trgm_idx", type: Gin)
  @@index([descriptionTa(ops: raw("gin_trgm_ops"))], map: "Product_descriptionTa_trgm_idx", type: Gin)
}

// A buyer account. The site takes no payment, so an account exists only to keep
// a shortlist of produce and farms to ring later — which is why it stores no
// address and no card.
model Customer {
  id            String         @id @default(cuid())
  // Stored lower-cased; the unique index is what stops duplicate signups.
  email         String         @unique
  // scrypt:<salt-hex>:<key-hex>. Never a plaintext or reversible value.
  passwordHash  String
  name          String
  phone         String?
  // Their own district, used to sort nearby farms first. Same table the farms
  // and listings use, so "Erode" is one row rather than three spellings.
  regionId      String?
  region        Region?        @relation(fields: [regionId], references: [id], onDelete: SetNull)
  // Which language to serve after sign-in, so the choice survives a new device.
  locale        String         @default("ta")
  status        CustomerStatus @default(ACTIVE)
  savedProducts SavedProduct[]
  savedFarmers  SavedFarmer[]
  // Set when the password last changed, so a support question about "why was I
  // signed out" has an answer.
  passwordSetAt DateTime?
  lastSeenAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([email])
  @@index([regionId])
  @@index([status])
}

// Suspending rather than deleting keeps the shortlist intact if an account is
// locked for abuse and later cleared.
enum CustomerStatus {
  ACTIVE
  SUSPENDED
}

model SavedProduct {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([customerId, productId])
  @@index([customerId, createdAt])
}

model SavedFarmer {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  farmerId   String
  farmer     Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([customerId, farmerId])
  @@index([customerId, createdAt])
}
