# Configuration now lives in conf/config.yaml (copy conf/config.example.yaml).
#
# This file is only for hosted deployments that inject plain environment
# variables — every ${VAR} reference in conf/config.example.yaml reads from here,
# and an environment variable always overrides the YAML value.

# PostgreSQL connection string. Injected automatically by Render's managed database.
# For Supabase use the transaction-mode pooler (port 6543) so serverless instances
# do not exhaust the connection limit.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode pooler (port 5432). Only `prisma migrate` uses it.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Public base URL of the deployment. Password-reset links and every canonical/OG
# URL are built from this, so it must be the domain people actually visit.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ISO 4217 currency code used to format prices in the UI (inlined at build time).
NEXT_PUBLIC_CURRENCY="INR"
NEXT_PUBLIC_LOCALE="en-IN"

# Published on the privacy page as the address for a data request. Required once
# APP_ENV is prod.
CONTACT_EMAIL=""
CONTACT_PLACE=""

# Farmer numbers stay hidden until this is "true".
SHOW_FARMER_PHONE="false"

# Buyer accounts. Sessions and the login rate limiter live in Redis, so REDIS_URL
# is required whenever accounts are on and APP_ENV is prod.
ACCOUNTS_ENABLED="false"
ACCOUNTS_SESSION_SECRET=""
REDIS_URL=""
REDIS_KEY_PREFIX="organics:"

# Sends the password-reset link and nothing else. With SMTP_HOST empty the reset
# route is not offered at all; in dev the link is written to the server log.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
