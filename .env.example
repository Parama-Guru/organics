# Copy to .env and fill in real values. NEVER commit .env.

# PostgreSQL connection string.
# Local docker-compose default is shown below.
# On Render this is injected automatically from the managed database.
DATABASE_URL="postgresql://organics:organics@localhost:5432/organics?schema=public"

# Public base URL of the deployment, used for canonical/OG metadata.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ISO 4217 currency code used to format prices in the UI.
NEXT_PUBLIC_CURRENCY="USD"

# Flat delivery fee in minor units (cents). Orders above the threshold ship free.
DELIVERY_FEE_CENTS="499"
FREE_DELIVERY_THRESHOLD_CENTS="5000"
