# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-dev/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - never commit real secrets; the template is tracked explicitly
.env*
!.env.example

# app config - conf/config.yaml holds real secrets; only the template is tracked
/conf/config.yaml
# Downloaded Google OAuth JSON contains a client secret. Runtime reads env vars;
# these files must never enter Git, Docker, or a public repository.
/conf/client_secret*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors
.idea/
.vscode/*
!.vscode/extensions.json
